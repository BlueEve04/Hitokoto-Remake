<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    card_view:cardCornerRadius="24dp"
    card_view:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/cardText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/hrd"
            android:gravity="center"
            android:overScrollMode="always"

            android:scrollbarStyle="insideInset"
            android:scrollbars="vertical"
            android:text="每日一言"
            android:textColor="@color/setting_title"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/cardCreator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="录入者"
            android:textColor="@color/txt_mostsmall"
            android:textSize="12sp" />
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginVertical="2dp"
            android:backgroundTint="@color/setting_subtitle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 上方一行：左出处右作者 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/cardFrom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:text="—— 出处"
                    android:textColor="@color/setting_subtitle"
                    android:textSize="16sp" />
<!--    <com.google.android.material.divider.MaterialDivider-->
<!--    android:layout_width="2dp"-->
<!--        android:layout_height="match_parent"-->
<!--        />-->
                <TextView
                    android:id="@+id/cardFromWho"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="角色/作者"
                    android:gravity="end"
                    android:textColor="@color/setting_subtitle"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 下方录入者居中 -->

        </LinearLayout>




    </LinearLayout>


</androidx.cardview.widget.CardView>
